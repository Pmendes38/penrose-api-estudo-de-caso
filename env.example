# Configure apenas a base local de estudo, nunca uma base de produção.
PORT=4001
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=penrose_demo
COMMERCE_MODE=demo
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=
# Preencha com segredos novos e longos, exclusivos de sua máquina.
JWT_SECRET=
HASH_PEPPER=
# Opcional: senha local com pelo menos 16 caracteres para o inicializador DEMO.
DEMO_ADMIN_PASSWORD=
# Não são necessários para avaliar o fluxo simulado.
ASAAS_API_KEY=
